        <div>
          <h3 style="margin-bottom: 1rem;">Your Saved Rosters</h3>
          <div id="roster-list" style="display: flex; flex-direction: column; gap: 1rem;">
            <!-- Loaded dynamically -->
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- AUTH MODAL -->
  <div class="modal" id="auth-modal">
    <div class="modal-content">
      <h3 id="modal-title" style="margin-bottom: 1rem;">Login</h3>
      <form onsubmit="handleAuthSubmit(event)">
        <div style="margin-bottom: 1rem;">
          <label style="display:block; font-size:0.85rem; margin-bottom:0.4rem;">Username</label>
          <input type="text" id="auth-username" required placeholder="Enter username">
        </div>
        <button type="submit" class="btn" style="width: 100%;">Continue</button>
        <button type="button" class="btn btn-outline" style="width: 100%; margin-top: 0.5rem;" onclick="closeAuthModal()">Cancel</button>
      </form>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <footer>
    <p>&copy; 2026 Football Passion Web Application. Built for American Football Fans.</p>
  </footer>

  <script>
    // --- ANIMATED STADIUM FIELD CANVAS LOGIC ---
    const canvas = document.getElementById('field-canvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    let lineOffset = 0;
    function drawFieldBackground() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Deep turf gradient background
      const grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
      grad.addColorStop(0, '#041008');
      grad.addColorStop(0.5, '#0B2211');
      grad.addColorStop(1, '#030C06');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Ambient stadium spotlights moving subtly
      const time = Date.now() * 0.001;
      const lightX = canvas.width * 0.5 + Math.sin(time * 0.5) * (canvas.width * 0.3);
      const lightGrad = ctx.createRadialGradient(lightX, 0, 50, lightX, 0, canvas.height * 0.8);
      lightGrad.addColorStop(0, 'rgba(30, 86, 49, 0.25)');
      lightGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = lightGrad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Animated scrolling gridiron yard lines (perspective feel)
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
      ctx.lineWidth = 2;
      const spacing = 80;
      lineOffset = (lineOffset + 0.3) % spacing;

      for (let y = -spacing + lineOffset; y < canvas.height + spacing; y += spacing) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }

      requestAnimationFrame(drawFieldBackground);
    }
    drawFieldBackground();


    // --- SEED DATABASE ENTRIES (8 REAL SUPERSTARS) ---
    const playersSeed = [
      { id: '1', name: 'Patrick Mahomes', position: 'QB', team: 'Kansas City Chiefs', rating: 99, passingYds: 4183, touchdowns: 27, speedScore: 82, img: 'https://images.unsplash.com/photo-1566577739112-5180d4bf9390?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' },
      { id: '2', name: 'Justin Jefferson', position: 'WR', team: 'Minnesota Vikings', rating: 98, passingYds: 0, touchdowns: 10, speedScore: 94, img: 'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' },
      { id: '3', name: 'Christian McCaffrey', position: 'RB', team: 'San Francisco 49ers', rating: 98, passingYds: 0, touchdowns: 21, speedScore: 91, img: 'https://images.unsplash.com/photo-1612872087720-bb876e2e67d1?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' },
      { id: '4', name: 'Lamar Jackson', position: 'QB', team: 'Baltimore Ravens', rating: 97, passingYds: 3678, touchdowns: 24, speedScore: 96, img: 'https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' },
      { id: '5', name: 'Nick Bosa', position: 'EDGE', team: 'San Francisco 49ers', rating: 96, passingYds: 0, touchdowns: 0, speedScore: 88, img: 'https://images.unsplash.com/photo-1566577739112-5180d4bf9390?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' },
      { id: '6', name: 'Travis Kelce', position: 'TE', team: 'Kansas City Chiefs', rating: 95, passingYds: 0, touchdowns: 8, speedScore: 85, img: 'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' },
      { id: '7', name: 'Micah Parsons', position: 'EDGE', team: 'Dallas Cowboys', rating: 97, passingYds: 0, touchdowns: 0, speedScore: 93, img: 'https://images.unsplash.com/photo-1612872087720-bb876e2e67d1?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' },
      { id: '8', name: 'Ja\'Marr Chase', position: 'WR', team: 'Cincinnati Bengals', rating: 95, passingYds: 0, touchdowns: 12, speedScore: 95, img: 'https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?auto=format&fit=crop&w=600&q=80', video: 'https://www.youtube.com/embed/dQw4w9WgXcQ' }
    ];

    const funFacts = [
      "The longest field goal in NFL history is 66 yards, kicked by Justin Tucker in 2021.",
      "An NFL football is nicknamed the 'pigskin', but they have always been made of cowhide leather!",
      "The Green Bay Packers are the only publicly non-profit, fan-owned team in American professional sports.",
      "A Super Bowl winning team receives the Vince Lombardi Trophy, made solid of sterling silver by Tiffany & Co."
    ];

    // --- STATE MANAGEMENT ---
    let currentUser = localStorage.getItem('fp_user') || null;
    let rosters = JSON.parse(localStorage.getItem('fp_rosters')) || [];
    let comments = JSON.parse(localStorage.getItem('fp_comments')) || {};
    let personalNotes = JSON.parse(localStorage.getItem('fp_notes')) || {};

    // --- APP INITIALIZATION ---
    document.addEventListener('DOMContentLoaded', () => {
      initCountdown();
      loadRandomFact();
      renderAuthUI();
      renderSpotlight();
      renderDirectory();
      populateDropdowns();
      renderRosters();
    });

    // --- VIEW ROUTING ---
    function switchView(viewName) {
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      
      const targetView = document.getElementById(`view-${viewName}`);
      const targetNav = document.getElementById(`nav-${viewName}`);
      
      if (targetView) targetView.classList.add('active');
      if (targetNav) targetNav.classList.add('active');

      if(viewName === 'compare') renderComparison();
      window.scrollTo(0, 0);
    }

    // --- FEATURE: DARK/LIGHT THEME ---
    function toggleTheme() {
      const body = document.body;
      const current = body.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      body.setAttribute('data-theme', next);
      showToast(`Switched to ${next} theme`);
    }

    // --- FEATURE: COUNTDOWN TIMER ---
    function initCountdown() {
      const targetDate = new Date().getTime() + (90 * 24 * 60 * 60 * 1000); // 90 days out
      setInterval(() => {
        const now = new Date().getTime();
        const diff = targetDate - now;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secs = Math.floor((diff % (1000 * 60)) / 1000);

        document.getElementById('cd-days').innerText = String(days).padStart(2, '0');
        document.getElementById('cd-hours').innerText = String(hours).padStart(2, '0');
        document.getElementById('cd-mins').innerText = String(mins).padStart(2, '0');
        document.getElementById('cd-secs').innerText = String(secs).padStart(2, '0');
      }, 1000);
    }

    // --- FEATURE: DAILY FUN FACT ---
    function loadRandomFact() {
      const idx = Math.floor(Math.random() * funFacts.length);
      document.getElementById('fun-fact-text').innerText = `"${funFacts[idx]}"`;
    }

    // --- FEATURE: SPOTLIGHT ITEM ---
    function renderSpotlight() {
      const p = playersSeed[0];
      document.getElementById('featured-player-spotlight').innerHTML = `
        <div style="display:flex; gap:1rem; align-items:center;">
          <img src="${p.img}" alt="${p.name}" style="width:90px; height:90px; border-radius:8px; object-fit:cover;">
          <div>
            <span class="badge badge-accent">${p.position}</span>
            <h4 style="margin-top:0.3rem;">${p.name}</h4>
            <p style="font-size:0.85rem; color:var(--text-muted);">${p.team}</p>
            <button class="btn btn-outline" style="padding:0.3rem 0.6rem; font-size:0.8rem; margin-top:0.5rem;" onclick="openPlayerDetail('${p.id}')">View Player Stats</button>
          </div>
        </div>
      `;
    }

    // --- VIEW 2: SEARCH & FILTER DIRECTORY ---
    function renderDirectory() {
      const search = document.getElementById('search-input').value.toLowerCase();
      const posFilter = document.getElementById('position-filter').value;
      const grid = document.getElementById('player-grid');

      const filtered = playersSeed.filter(p => {
        const matchesSearch = p.name.toLowerCase().includes(search) || p.team.toLowerCase().includes(search);
        const matchesPos = posFilter === 'ALL' || p.position === posFilter;
        return matchesSearch && matchesPos;
      });

      if(filtered.length === 0) {
        grid.innerHTML = `<div style="grid-column: 1/-1; text-align:center; padding: 2rem; color: var(--text-muted);">No players found matching criteria.</div>`;
        return;
      }

      grid.innerHTML = filtered.map(p => `
        <div class="player-card">
          <img src="${p.img}" alt="${p.name}" class="player-img">
          <div class="player-info">
            <div>
              <div class="player-header">
                <h3>${p.name}</h3>
                <span class="badge">${p.position}</span>
              </div>
              <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1rem;">${p.team}</p>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span style="font-weight:700; color:var(--accent);">OVR: ${p.rating}</span>
              <button class="btn btn-outline" onclick="openPlayerDetail('${p.id}')">Deep Dive →</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // --- VIEW 3: DETAIL VIEW WITH NOTES & COMMENTS ---
    function openPlayerDetail(id) {
      const p = playersSeed.find(item => item.id === id);
      if(!p) return;

      const pComments = comments[id] || [];
      const userNote = personalNotes[id] || '';

      const container = document.getElementById('player-detail-container');
      container.innerHTML = `
        <div class="card">
          <div style="display:flex; gap:2rem; flex-wrap:wrap;">
            <img src="${p.img}" style="width:100%; max-width:300px; height:300px; object-fit:cover; border-radius:8px;">
            <div style="flex:1;">
              <span class="badge badge-accent">${p.position}</span>
              <h1 style="font-size:2.2rem; margin:0.5rem 0;">${p.name}</h1>
              <h3 style="color:var(--text-muted); font-weight:500;">${p.team}</h3>
              <div style="margin:1.5rem 0;" class="grid-3">
                <div style="background:var(--input-bg); padding:1rem; border-radius:6px; text-align:center;">
                  <span style="display:block; font-size:0.8rem; color:var(--text-muted);">OVERALL RATING</span>
                  <strong style="font-size:1.6rem; color:var(--accent);">${p.rating}</strong>
                </div>
                <div style="background:var(--input-bg); padding:1rem; border-radius:6px; text-align:center;">
                  <span style="display:block; font-size:0.8rem; color:var(--text-muted);">TOUCHDOWNS</span>
                  <strong style="font-size:1.6rem;">${p.touchdowns}</strong>
                </div>
                <div style="background:var(--input-bg); padding:1rem; border-radius:6px; text-align:center;">
                  <span style="display:block; font-size:0.8rem; color:var(--text-muted);">SPEED SCORE</span>
                  <strong style="font-size:1.6rem;">${p.speedScore}</strong>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid-2">
          <!-- EMBEDDED VIDEO PLAYER FEATURE -->
          <div class="card">
            <h3>📹 Highlight Reel</h3>
            <div class="responsive-video">
              <iframe src="${p.video}" title="Highlights" allowfullscreen></iframe>
            </div>
          </div>

          <!-- PERSONAL NOTES FEATURE (Logged in) -->
          <div class="card">
            <h3>📝 Personal Scouting Notes</h3>
            <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;">Private notes saved in your account.</p>
            ${currentUser ? `
              <textarea id="note-input-${p.id}" rows="5" placeholder="Write scouting report notes here...">${userNote}</textarea>
              <button class="btn" style="margin-top:0.75rem;" onclick="saveNote('${p.id}')">Save Notes</button>
            ` : `<p style="color:var(--accent);">Please login to save personal notes.</p>`}
          </div>
        </div>

        <!-- COMMENTS SECTION FEATURE -->
        <div class="card">
          <h3>💬 Fan Comments</h3>
          <div style="margin:1rem 0;" id="comments-list">
            ${pComments.length === 0 ? '<p style="color:var(--text-muted);">No comments yet. Be the first!</p>' : ''}
            ${pComments.map(c => `
              <div style="background:var(--input-bg); padding:0.75rem 1rem; border-radius:6px; margin-bottom:0.5rem;">
                <strong>${c.user}:</strong> <span style="color:var(--text-muted);">${c.text}</span>
              </div>
            `).join('')}
          </div>
          ${currentUser ? `
            <div style="display:flex; gap:0.5rem;">
              <input type="text" id="comment-input-${p.id}" placeholder="Add a public comment...">
              <button class="btn" onclick="addComment('${p.id}')">Post</button>
            </div>
          ` : `<p style="color:var(--text-muted); font-size:0.9rem;">Log in to join the conversation.</p>`}
        </div>
      `;

      switchView('detail');
    }

    function saveNote(playerId) {
      const val = document.getElementById(`note-input-${playerId}`).value;
      personalNotes[playerId] = val;
      localStorage.setItem('fp_notes', JSON.stringify(personalNotes));
      showToast('Scouting notes saved!');
    }

    function addComment(playerId) {
      const input = document.getElementById(`comment-input-${playerId}`);
      if(!input.value.trim()) return;

      if(!comments[playerId]) comments[playerId] = [];
      comments[playerId].push({ user: currentUser, text: input.value.trim() });
      localStorage.setItem('fp_comments', JSON.stringify(comments));

      openPlayerDetail(playerId);
      showToast('Comment posted!');
    }

    // --- VIEW 4: COMPARISON TOOL ---
    function populateDropdowns() {
      const s1 = document.getElementById('compare-select-1');
      const s2 = document.getElementById('compare-select-2');
      const options = playersSeed.map(p => `<option value="${p.id}">${p.name} (${p.position})</option>`).join('');

      s1.innerHTML = options;
      s2.innerHTML = options;
      if(playersSeed.length > 1) s2.value = playersSeed[1].id;

      // Populate Roster selects
      const qbs = playersSeed.filter(p => p.position === 'QB').map(p => `<option value="${p.name}">${p.name}</option>`).join('');
      const wrs = playersSeed.filter(p => p.position === 'WR').map(p => `<option value="${p.name}">${p.name}</option>`).join('');
      const rbs = playersSeed.filter(p => p.position === 'RB').map(p => `<option value="${p.name}">${p.name}</option>`).join('');

      document.getElementById('roster-qb').innerHTML = qbs;
      document.getElementById('roster-wr').innerHTML = wrs;
      document.getElementById('roster-rb').innerHTML = rbs;
    }

    function renderComparison() {
      const id1 = document.getElementById('compare-select-1').value;
      const id2 = document.getElementById('compare-select-2').value;

      const p1 = playersSeed.find(p => p.id === id1);
      const p2 = playersSeed.find(p => p.id === id2);

      const renderStatRow = (label, val1, val2, maxVal) => {
        const pct1 = Math.min(100, Math.round((val1 / maxVal) * 100));
        const pct2 = Math.min(100, Math.round((val2 / maxVal) * 100));

        return `
          <div style="margin-bottom: 1.5rem;">
            <div style="display:flex; justify-content:space-between; font-weight:600; margin-bottom:0.25rem;">
              <span>${val1}</span>
              <span style="color:var(--text-muted);">${label}</span>
              <span>${val2}</span>
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.5rem;">
              <div class="stat-bar-bg" style="transform: scaleX(-1);"><div class="stat-bar-fill" style="width:${pct1}%"></div></div>
              <div class="stat-bar-bg"><div class="stat-bar-fill" style="width:${pct2}%"></div></div>
            </div>
          </div>
        `;
      };

      document.getElementById('comparison-results').innerHTML = `
        <div class="card">
          <div class="grid-2" style="text-align:center; margin-bottom:2rem;">
            <div>
              <img src="${p1.img}" style="width:100px; height:100px; border-radius:50%; object-fit:cover; border: 2px solid var(--accent);">
              <h3 style="margin-top:0.5rem;">${p1.name}</h3>
              <span class="badge">${p1.position} - ${p1.team}</span>
            </div>
            <div>
              <img src="${p2.img}" style="width:100px; height:100px; border-radius:50%; object-fit:cover; border: 2px solid var(--accent);">
              <h3 style="margin-top:0.5rem;">${p2.name}</h3>
              <span class="badge">${p2.position} - ${p2.team}</span>
            </div>
          </div>
          ${renderStatRow('Overall Rating', p1.rating, p2.rating, 100)}
          ${renderStatRow('Touchdowns', p1.touchdowns, p2.touchdowns, 30)}
          ${renderStatRow('Speed Score', p1.speedScore, p2.speedScore, 100)}
        </div>
      `;
    }

    // --- VIEW 5: FULL CRUD ROSTER BUILDER ---
    function handleSaveRoster(e) {
      e.preventDefault();
      if(!currentUser) {
        showToast('Please login to save rosters!');
        openAuthModal();
        return;
      }

      const id = document.getElementById('roster-edit-id').value;
      const name = document.getElementById('roster-name').value;
      const qb = document.getElementById('roster-qb').value;
      const wr = document.getElementById('roster-wr').value;
      const rb = document.getElementById('roster-rb').value;
      const notes = document.getElementById('roster-notes').value;

      if(id) {
        // Update
        const idx = rosters.findIndex(r => r.id === id);
        if(idx !== -1) {
          rosters[idx] = { id, name, qb, wr, rb, notes, user: currentUser };
          showToast('Roster updated!');
        }
      } else {
        // Create
        const newRoster = { id: Date.now().toString(), name, qb, wr, rb, notes, user: currentUser };
        rosters.push(newRoster);
        showToast('Roster created!');
      }

      localStorage.setItem('fp_rosters', JSON.stringify(rosters));
      resetRosterForm();
      renderRosters();
    }

    function renderRosters() {
      const container = document.getElementById('roster-list');
      if(rosters.length === 0) {
        container.innerHTML = `<div class="card" style="color:var(--text-muted); text-align:center;">No custom rosters saved yet.</div>`;
        return;
      }

      container.innerHTML = rosters.map(r => `
        <div class="card" style="margin-bottom:0;">
          <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <h4>${r.name}</h4>
            <span style="font-size:0.75rem; color:var(--accent);">By ${r.user}</span>
          </div>
          <p style="font-size:0.85rem; color:var(--text-muted); margin: 0.5rem 0;">
            <strong>Starters:</strong> QB: ${r.qb} | WR: ${r.wr} | RB: ${r.rb}
          </p>
          ${r.notes ? `<p style="font-size:0.85rem; font-style:italic; color:var(--text-main);">"${r.notes}"</p>` : ''}
          ${currentUser === r.user ? `
            <div style="display:flex; gap:0.5rem; margin-top:1rem;">
              <button class="btn btn-outline" style="padding:0.3rem 0.6rem; font-size:0.8rem;" onclick="editRoster('${r.id}')">Edit</button>
              <button class="btn btn-danger" style="padding:0.3rem 0.6rem; font-size:0.8rem;" onclick="deleteRoster('${r.id}')">Delete</button>
            </div>
          ` : ''}
        </div>
      `).join('');
    }

    function editRoster(id) {
      const r = rosters.find(item => item.id === id);
      if(!r) return;

      document.getElementById('roster-edit-id').value = r.id;
      document.getElementById('roster-name').value = r.name;
      document.getElementById('roster-qb').value = r.qb;
      document.getElementById('roster-wr').value = r.wr;
      document.getElementById('roster-rb').value = r.rb;
      document.getElementById('roster-notes').value = r.notes || '';

      document.getElementById('roster-form-title').innerText = 'Edit Roster';
      document.getElementById('roster-cancel-btn').style.display = 'inline-block';
    }

    function deleteRoster(id) {
      rosters = rosters.filter(r => r.id !== id);
      localStorage.setItem('fp_rosters', JSON.stringify(rosters));
      renderRosters();
      showToast('Roster deleted.');
    }

    function resetRosterForm() {
      document.getElementById('roster-edit-id').value = '';
      document.getElementById('roster-form').reset();
      document.getElementById('roster-form-title').innerText = 'Create New Roster';
      document.getElementById('roster-cancel-btn').style.display = 'none';
    }

    // --- FEATURE: EXPORT TO CSV ---
    function exportRostersCSV() {
      if(rosters.length === 0) {
        showToast('No rosters available to export!');
        return;
      }
      let csv = 'ID,Roster Name,Quarterback,Wide Receiver,Running Back,Creator,Notes\n';
      rosters.forEach(r => {
        csv += `"${r.id}","${r.name}","${r.qb}","${r.wr}","${r.rb}","${r.user}","${r.notes || ''}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.setAttribute('href', url);
      a.setAttribute('download', 'football_passion_rosters.csv');
      a.click();
      showToast('Exported rosters to CSV!');
    }

    // --- AUTHENTICATION MODULE ---
    function renderAuthUI() {
      const container = document.getElementById('auth-section');
      if(currentUser) {
        container.innerHTML = `
          <span style="font-size:0.85rem; color:var(--accent);">👤 ${currentUser}</span>
          <button class="btn btn-outline" style="padding:0.4rem 0.8rem;" onclick="logout()">Logout</button>
        `;
      } else {
        container.innerHTML = `
          <button class="btn btn-accent" style="padding:0.4rem 0.8rem;" onclick="openAuthModal()">Login</button>
        `;
      }
    }

    function openAuthModal() { document.getElementById('auth-modal').classList.add('active'); }
    function closeAuthModal() { document.getElementById('auth-modal').classList.remove('active'); }

    function handleAuthSubmit(e) {
      e.preventDefault();
      const user = document.getElementById('auth-username').value.trim();
      if(user) {
        currentUser = user;
        localStorage.setItem('fp_user', currentUser);
        renderAuthUI();
        renderRosters();
        closeAuthModal();
        showToast(`Welcome back, ${currentUser}!`);
      }
    }

    function logout() {
      currentUser = null;
      localStorage.removeItem('fp_user');
      renderAuthUI();
      renderRosters();
      showToast('Logged out.');
    }

    // --- TOAST FEEDBACK MODULE ---
    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }
  </script>
</body>
</html>