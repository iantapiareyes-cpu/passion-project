    <!-- VIEW 3: PLAYER DEEP-DIVE -->
    <section id="view-detail" class="view">
      <button class="btn btn-outline" style="margin-bottom: 1.5rem;" onclick="switchView('directory')">← Back to Directory</button>
      <div id="player-detail-container">
        <!-- Rendered dynamically -->
      </div>
    </section>

    <!-- VIEW 4: HEAD-TO-HEAD COMPARISON -->
    <section id="view-compare" class="view">
      <div class="card">
        <h2>⚡ Head-to-Head Player Comparison</h2>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Select any two players to compare key performance metrics side-by-side.</p>
        <div class="grid-2">
