  <main class="container">

    <!-- VIEW 1: HOME HUB -->
    <section id="view-home" class="view active">
      <div class="hero">
        <h2>Kickoff Countdown</h2>
        <p style="color: #E2E8F0; margin-top: 0.5rem;">Countdown to the Championship Game</p>
        <div class="countdown-timer">
