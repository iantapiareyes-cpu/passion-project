<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Football Passion - Ultimate Fan Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #06101E;
      --bg-card: rgba(30, 41, 59, 0.85);
      --bg-nav: rgba(7, 19, 38, 0.95);
      --text-main: #F8F9FA;
      --text-muted: #94A3B8;
      --primary: #1E5631;
      --primary-hover: #276E3F;
      --accent: #FFB800;
      --border: rgba(51, 65, 85, 0.6);
      --danger: #EF4444;
      --input-bg: #0F172A;
    }

    [data-theme="light"] {
      --bg-main: #E2E8F0;
      --bg-card: rgba(255, 255, 255, 0.9);
      --bg-nav: rgba(11, 29, 58, 0.95);
      --text-main: #0F172A;
      --text-muted: #64748B;
      --primary: #1E5631;
      --primary-hover: #276E3F;
      --accent: #D97706;
      --border: rgba(226, 232, 240, 0.8);
      --danger: #DC2626;
      --input-bg: #FFFFFF;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; transition: background-color 0.2s, color 0.2s; }
    body { background-color: var(--bg-main); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; position: relative; overflow-x: hidden; }
    h1, h2, h3, h4, .brand-title { font-family: 'Montserrat', sans-serif; text-transform: uppercase; }

    /* Animated Stadium Field Canvas Background */
    #field-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      pointer-events: none;
    }

    /* Navigation */
    .navbar { background-color: var(--bg-nav); backdrop-filter: blur(10px); border-bottom: 2px solid var(--border); padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; position: sticky; top: 0; z-index: 100; }
    .brand { display: flex; align-items: center; gap: 0.5rem; font-size: 1.4rem; font-weight: 900; color: #FFF; text-decoration: none; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
    .brand span { color: var(--accent); }
    .nav-links { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .nav-btn { background: transparent; border: 1px solid transparent; color: #94A3B8; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.9rem; }
    .nav-btn:hover, .nav-btn.active { color: #FFF; background: rgba(255,255,255,0.1); border-color: var(--border); }
    .nav-btn.active { border-bottom: 2px solid var(--accent); color: var(--accent); }
    .nav-controls { display: flex; gap: 0.75rem; align-items: center; }

    /* Buttons & Inputs */
    .btn { background-color: var(--primary); color: #FFF; border: none; padding: 0.6rem 1.2rem; border-radius: 6px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; box-shadow: 0 4px 6px rgba(0,0,0,0.2); }
    .btn:hover { background-color: var(--primary-hover); transform: translateY(-1px); }
    .btn-accent { background-color: var(--accent); color: #000; }
    .btn-accent:hover { opacity: 0.9; }
    .btn-danger { background-color: var(--danger); }
    .btn-outline { background: rgba(0,0,0,0.2); border: 1px solid var(--border); color: var(--text-main); }
    .btn-outline:hover { background: rgba(255,255,255,0.1); }

    input, select, textarea { background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border); padding: 0.6rem 1rem; border-radius: 6px; font-size: 0.95rem; outline: none; width: 100%; }
    input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(255,184,0,0.2); }

    /* Layout Containers */
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; width: 100%; flex: 1; position: relative; z-index: 1; }
    .view { display: none; }
    .view.active { display: block; animation: fadeIn 0.3s ease-in-out; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Cards & Grids */
    .card { background: var(--bg-card); backdrop-filter: blur(12px); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3); }
    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }

    /* Hero & Widgets */
    .hero { background: linear-gradient(135deg, rgba(30,86,49,0.85), rgba(11,29,58,0.9)), url('https://images.unsplash.com/photo-1566577739112-5180d4bf9390?auto=format&fit=crop&w=1200&q=80') center/cover; padding: 3rem 2rem; border-radius: 12px; text-align: center; margin-bottom: 2rem; border: 1px solid var(--border); box-shadow: 0 10px 30px rgba(0,0,0,0.4); }
    .countdown-timer { display: flex; justify-content: center; gap: 1rem; margin-top: 1.5rem; }
    .timer-block { background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); padding: 0.75rem 1.25rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.15); min-width: 70px; }
    .timer-num { font-size: 1.8rem; font-weight: 800; color: var(--accent); }
    .timer-label { font-size: 0.75rem; text-transform: uppercase; color: #94A3B8; }

    .badge { background: var(--primary); color: #FFF; padding: 0.25rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
    .badge-accent { background: var(--accent); color: #000; }

    /* Player Card UI */
    .player-card { background: var(--bg-card); backdrop-filter: blur(10px); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 6px 20px rgba(0,0,0,0.2); }
    .player-img { width: 100%; height: 220px; object-fit: cover; border-bottom: 1px solid var(--border); }
    .player-info { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .player-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; }

    /* Comparison Bar Visuals */
    .stat-bar-bg { background: var(--input-bg); height: 10px; border-radius: 5px; overflow: hidden; margin-top: 0.25rem; border: 1px solid var(--border); }
    .stat-bar-fill { background: var(--accent); height: 100%; width: 0%; transition: width 0.4s ease; }

    /* Modal / Auth Overlay */
    .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(5px); z-index: 1000; justify-content: center; align-items: center; padding: 1rem; }
    .modal.active { display: flex; }
    .modal-content { background: var(--bg-card); backdrop-filter: blur(15px); border: 1px solid var(--border); padding: 2rem; border-radius: 12px; width: 100%; max-width: 420px; box-shadow: 0 15px 35px rgba(0,0,0,0.5); }

    /* Video Container */
    .responsive-video { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; margin: 1rem 0; border: 1px solid var(--border); }
    .responsive-video iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }

    /* Toast Notification */
    .toast { position: fixed; bottom: 20px; right: 20px; background: var(--primary); color: #FFF; padding: 1rem 1.5rem; border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.4); display: none; z-index: 2000; border: 1px solid rgba(255,255,255,0.2); font-weight: 600; }

    footer { background: var(--bg-nav); backdrop-filter: blur(10px); border-top: 1px solid var(--border); text-align: center; padding: 1.5rem; margin-top: auto; font-size: 0.85rem; color: var(--text-muted); position: relative; z-index: 1; }
  </style>
</head>
<body>

  <!-- Animated Background Canvas (Gridiron Field & Stadium Lights) -->
  <canvas id="field-canvas"></canvas>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <a href="#" class="brand" onclick="switchView('home')">🏈 FOOTBALL <span>PASSION</span></a>
